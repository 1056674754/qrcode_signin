{
  "name": "qrcode-signin-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/private-artifacts.mjs invalidate",
    "build": "tsc -b && vite build && node scripts/private-artifacts.mjs stage",
    "monitoring:upload": "node scripts/private-artifacts.mjs upload",
    "monitoring:verify": "node scripts/private-artifacts.mjs verify",
    "test:monitoring": "bun test ./.tests/monitoring.test.ts && node --test .tests/private-artifacts.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/browser": "9.47.1",
    "@sentry/core": "9.47.1",
    "jsqr": "^1.4.0",
    "pocketbase": "^0.26.8",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "3.6.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "~5.6.2",
    "vite": "^5.4.10"
  }
}
