# 复制为 .env 后 docker compose 会读取
# 前端构建与 PocketBase 容器都会用到；OAuth2 详见 docs/OIDC-PROVIDER.md

# 前端（构建时打进静态包）
# 生产环境：留空或 '/' = 同源（nginx 代理 /api 到 pocketbase）
# 开发/测试：http://localhost:8090 或 http://你的域名:8090
VITE_POCKETBASE_URL=
VITE_OAUTH_PROVIDER=oidc

# Nginx 监听端口（默认 80，生产建议用 443 + SSL）
NGINX_PORT=80

# PocketBase Admin（可选，首次自动创建 superuser）
# PB_ADMIN_EMAIL=admin@example.com
# PB_ADMIN_PASSWORD=your-secure-password

# OAuth2（必填：无 compose 默认值，请填你的 IdP 文档中的端点）
PB_OAUTH2_PROVIDER_NAME=oidc
PB_OAUTH2_CLIENT_ID=你的client_id
PB_OAUTH2_CLIENT_SECRET=你的client_secret
PB_OAUTH2_AUTH_URL=https://你的IdP域名/oauth/authorize
PB_OAUTH2_TOKEN_URL=https://你的IdP域名/oauth/token
PB_OAUTH2_USER_URL=https://你的IdP域名/oauth/userinfo
PB_OAUTH2_SCOPE=read email profile openid
