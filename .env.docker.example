# 复制为 .env 后 docker compose 会读取
# ---------------------------------------------------------------------------
# 默认：企业微信网页授权登录（服务端实现见 pb_hooks/wecom_auth.pb.js，说明见 docs/WECOM.md）

# 前端（构建参数；生产同源时 VITE_POCKETBASE_URL 留空）
VITE_POCKETBASE_URL=
VITE_AUTH_MODE=wecom
VITE_WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx   # 企业 ID，与自建应用 OAuth 所用 corpid 一致
VITE_WECOM_AGENT_ID=100000x             # 自建应用 AgentId

# Nginx（默认 80，生产配合 SSL）
NGINX_PORT=80

# PocketBase Admin（可选，首次自动创建 superuser）
# PB_ADMIN_EMAIL=admin@example.com
# PB_ADMIN_PASSWORD=your-secure-password

# 企业微信：服务端换取用户身份（须与上文 corpid/agent 同属一应用）
PB_WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
PB_WECOM_AGENT_SECRET=应用凭证密钥Secret
# 设为 1 时登录后额外请求通讯录「读取成员」，写入 PocketBase users.name（需在企微为该应用授予相应权限）
# PB_WECOM_FETCH_USER_DETAIL=1

# ---------------------------------------------------------------------------
# 若改用通用 OAuth2 / OIDC，请切换 VITE_AUTH_MODE=oauth2 并补齐下方变量，
# PocketBase OAuth2 详见 docs/OIDC-PROVIDER.md

# VITE_AUTH_MODE=oauth2
# VITE_OAUTH_PROVIDER=oidc
# PB_OAUTH2_PROVIDER_NAME=oidc
# PB_OAUTH2_CLIENT_ID=你的client_id
# PB_OAUTH2_CLIENT_SECRET=你的client_secret
# PB_OAUTH2_AUTH_URL=https://你的IdP域名/oauth/authorize
# PB_OAUTH2_TOKEN_URL=https://你的IdP域名/oauth/token
# PB_OAUTH2_USER_URL=https://你的IdP域名/oauth/userinfo
# PB_OAUTH2_SCOPE=read email profile openid
